# Copy this file to .env for local development. Never commit real credentials.
APP_NAME=AI System Trading API
APP_ENV=local
API_V1_PREFIX=/api/v1
# Replace both the username and password before starting the application.
# Percent-encode reserved password characters such as @, :, /, # and %.
DATABASE_URL=postgresql+psycopg://trade_bot_user:change-me@localhost:5432/general_system_db
DATABASE_SCHEMA=fx
CORS_ORIGINS=http://localhost:5173

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_ENCRYPTION_KEY=replace-with-generated-fernet-key
SECRET_STORE_PATH=.secrets

# OIDC login (Authorization Code + PKCE) against an external IdP you provide
# (Auth0, Okta, Microsoft Entra ID, or any other OIDC-discovery-compliant IdP).
# Register OIDC_REDIRECT_URI as this app's callback URL with that IdP.
OIDC_ISSUER=https://your-tenant.example.com/
OIDC_CLIENT_ID=change-me
OIDC_CLIENT_SECRET=change-me
OIDC_REDIRECT_URI=http://localhost:8000/api/v1/auth/callback
# Session cookie signing secret. Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SIGNING_SECRET=change-me

# Trading is intentionally disabled by default.
TRADING_ENV=paper
LIVE_TRADING_ALLOWED=false

# Signing secret for realtime market-data stream tickets (required; the
# ticket-issuance endpoint returns 503 until this is set). Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
MARKET_STREAM_TICKET_SECRET=change-me
# Optional tuning for the realtime market-data stream (defaults shown).
MARKET_STREAM_TICKET_TTL_SECONDS=60
MARKET_STREAM_GRACE_PERIOD_SECONDS=30.0
MARKET_STREAM_HEARTBEAT_INTERVAL_SECONDS=30.0
