# Copy this file to .env for local development. Never commit real credentials.
APP_NAME=AI System Trading API
APP_ENV=local
API_V1_PREFIX=/api/v1
# Replace both the username and password before starting the application.
# Percent-encode reserved password characters such as @, :, /, # and %.
DATABASE_URL=postgresql+psycopg://trade_bot_user:change-me@localhost:5432/general_system_db
DATABASE_SCHEMA=fx
CORS_ORIGINS=http://localhost:5173

# Development-only owner authentication. Replace with a long random value.
DEV_OWNER_TOKEN=change-me
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_ENCRYPTION_KEY=replace-with-generated-fernet-key
SECRET_STORE_PATH=.secrets

# Trading is intentionally disabled by default.
TRADING_ENV=paper
LIVE_TRADING_ALLOWED=false
